# Copiez ce fichier en .env et remplissez. Sans clé, le système tourne en SIMULATION.

# --- Kapso (recommandé) : app.kapso.ai > API keys
KAPSO_API_KEY=
KAPSO_API_BASE_URL=https://api.kapso.ai
# Secret du webhook créé dans Kapso (signature X-Webhook-Signature)
KAPSO_WEBHOOK_SECRET=
# Identifiant du numéro connecté (kapso whatsapp numbers list)
WA_PHONE_NUMBER_ID=

# --- OU Meta Cloud API en direct (laisser vide si Kapso)
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0

# --- Vous
SENDER_NAME=
SENDER_BUSINESS=
DEFAULT_COUNTRY=FR
TZ_BUSINESS=Europe/Paris

# --- Modèles Meta approuvés
TEMPLATE_LANG=fr
# Modèle de relance hors fenêtre de 24 h ({{1}} = prénom)
FOLLOWUP_TEMPLATE=
# Modèles autorisés à partir seuls en mode automatique (séparés par des virgules)
AUTO_TEMPLATES=

# --- Garde-fous
MAX_BUSINESS_INITIATED_PER_DAY=50
FOLLOWUP_DELAYS_DAYS=3,7
MIN_DAYS_BETWEEN_MESSAGES=3
SEND_HOUR_START=9
SEND_HOUR_END=20
# Vos propres numéros pour `npm run cli -- test-reel` (séparés par des virgules)
TEST_NUMBERS=

# --- Serveur
PORT=3020
HOST=127.0.0.1
# Obligatoire si le tableau de bord est exposé hors de votre Mac
DASHBOARD_TOKEN=

# --- Optionnel : rédaction par Claude (sinon formulations écrites à la main)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
