# Copier en .env.local (local) ou saisir dans Vercel > Settings > Environment Variables.
# Aucune de ces valeurs ne doit être commitée.

# URL publique définitive du site (sans slash final), utilisée pour les canoniques et le sitemap.
NEXT_PUBLIC_SITE_URL=https://www.exemple-a-remplacer.fr

# Transmission des demandes de devis par e-mail via Resend (https://resend.com).
RESEND_API_KEY=
# Adresse qui reçoit les demandes.
DEVIS_DESTINATAIRE=
# Expéditeur vérifié dans Resend (domaine validé), ex. "BTS DÉBARRAT <devis@votre-domaine.fr>".
DEVIS_EXPEDITEUR=
